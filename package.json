{
  "name": "tactile",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test:unit": "node --test tests/*.test.mjs tests/compatibility/*.test.mjs",
    "test:coverage": "c8 --clean --all --reporter=text-summary --reporter=json-summary --report-dir=coverage node --test tests/*.test.mjs tests/compatibility/*.test.mjs",
    "test:component": "playwright test --pass-with-no-tests --config playwright.component.config.mjs",
    "test:e2e": "playwright test --pass-with-no-tests --config playwright.e2e.config.mjs",
    "bench:perf": "node tests/performance/run-browser.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:component && npm run test:e2e && npm run build && npm run test:sites"
  },
  "dependencies": {
    "@fontsource-variable/lilex": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "c8": "^12.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.4.3"
  }
}
